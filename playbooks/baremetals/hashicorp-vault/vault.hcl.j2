api_addr = "http://{% for domain in local_domains %}{% if domain.name == 'vault' %}{{ domain.fqdn }}{% endif %}{% endfor %}"
ui = true

storage "file" {
  path = "/opt/vault/data"
}

# HTTP listener
listener "tcp" {
  address = "127.0.0.1:8200"
  tls_disable = 1
}

# Monitoring
telemetry {
  disable_hostname          = true
  prometheus_retention_time = "30s"
}
